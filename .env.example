# ─────────────────────────────────────────────────────────────────────────────
# Storage backend
#
# Default (local dev & CI): MinIO runs inside Docker Compose.
# The values below work out of the box with the bundled minio/createbuckets
# services in docker-compose.yml.
#
# Production (real AWS S3): replace the four lines below with real credentials,
# set AWS_ENDPOINT_URL to empty, and remove the minio/createbuckets services
# from docker-compose.yml.
# ─────────────────────────────────────────────────────────────────────────────
AWS_ACCESS_KEY_ID=minioadmin
AWS_SECRET_ACCESS_KEY=minioadmin
AWS_S3_BUCKET=mc2-app-storage-useast1
PDF_S3_BUCKET=aspiring-pdf-files
AWS_ENDPOINT_URL=http://minio:9000

# Dropbox OAuth (optional — only needed for Dropbox import/export feature)
DROPBOX_APP_KEY=your_dropbox_app_key_here
DROPBOX_APP_SECRET=your_dropbox_app_secret_here
DROPBOX_ACCESS_TOKEN=your_dropbox_access_token_here

# Application Secrets
COOKIE_SECRET=generate_a_random_secret_here

# Public base URL returned inside pdfurl JSON responses.
# The Ionic app emails, shares, and stores this URL, so it must be reachable
# by the end-user's device.  Strip any trailing slash.
#
# Local development:
#   PUBLIC_BASE_URL=http://localhost:8080
#
# EC2 (direct, no reverse proxy):
#   PUBLIC_BASE_URL=http://<EC2_PUBLIC_IP>
#
# Production behind a reverse proxy / ALB:
#   PUBLIC_BASE_URL=https://aspiringapps.com/api
#
# If unset, the URL is built from the incoming request's Host header
# (preserving the previous behaviour — safe for single-instance setups
# where the server is directly reachable).
#PUBLIC_BASE_URL=http://localhost:8080

# CORS allowlist for /webapp and /htmltopdf (comma separated, exact match, see handlers/cors.py).
# Unset = the Capacitor WebView origins below. Add your dev server origin, e.g. Vite:
#   ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost,http://localhost:5173
# A listed origin is echoed back (credentials only on /webapp); anything else gets no CORS headers.
# Do not use "*" for /webapp: it is never combined with credentials.
#ALLOWED_ORIGINS=capacitor://localhost,http://localhost,https://localhost

# MeshKit Kubo sidecar URL (used by MeshkitKuboSidecarHandler in cloudmain.py)
# Local dev:      http://localhost:5051  (requires a local Kubo daemon on port 5001)
# Docker Compose: http://meshkit-sidecar-kubo:5051  (set automatically via docker-compose environment block)
MESHKIT_KUBO_SIDECAR_URL=http://localhost:5051

# ── fastapi-interop sidecar (spreadsheet import/export + PDF), see handlers/interop.py ──
# Shared secret between Tornado and the sidecar. Generate one: openssl rand -hex 32
INTEROP_SHARED_SECRET=generate_a_random_secret_here
# Where Tornado reaches the sidecar (docker-compose overrides this to http://fastapi-interop:5053)
FASTAPI_INTEROP_URL=http://localhost:5053
# Bucket for generated exports (defaults to PDF_S3_BUCKET)
INTEROP_EXPORT_BUCKET=aspiring-pdf-files
# Explicit timeouts in seconds (connect, import, export, health). Timeout -> HTTP 504, unreachable -> 502
INTEROP_CONNECT_TIMEOUT=5
INTEROP_IMPORT_TIMEOUT=60
INTEROP_EXPORT_TIMEOUT=120
INTEROP_HEALTH_TIMEOUT=5
INTEROP_MAX_UPLOAD_MB=20
# Build context of the sidecar image (a checkout of touch-calc-fastapi-backend-libp2p-testing)
# FASTAPI_INTEROP_CONTEXT=../touch-calc-fastapi-backend-libp2p-testing
