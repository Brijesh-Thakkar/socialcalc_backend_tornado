# toju-sidecar config. Copy to .env (gitignored) and fill in. NEVER commit real secrets.

# ── Required ────────────────────────────────────────────────────────────────
# TOJU_MODE is REQUIRED and must be set explicitly — there is NO default.
#   mock = offline, no real Solana/IPFS/money (drives the SDK against toju-mock). Used by CI.
#   real = broadcasts a REAL deposit tx and spends REAL funds on SOLANA_CLUSTER.
# The sidecar refuses to start if TOJU_MODE is unset or not one of mock|real.
TOJU_MODE=mock

TOJU_SIDECAR_PORT=5056
# Shared secret required on every request (X-Toju-Token). MUST match Tornado's TOJU_SHARED_SECRET.
TOJU_SHARED_SECRET=change-me-dev-only
# Backend the SDK calls.  mock: the local toju-mock (http://localhost:5057).
#                         real: a toju server, e.g. local self-host http://localhost:5040,
#                               or toju's hosted API https://api.toju.network once it is back.
TOJU_API_URL=http://localhost:5057

# ── Real mode only (ignored in mock mode) ────────────────────────────────────
# Solana cluster for the on-chain deposit. Allowed: devnet | testnet.
# Picks the default RPC and the SDK Environment. Mainnet is refused (see ALLOW_MAINNET).
SOLANA_CLUSTER=devnet
# Optional explicit RPC override (else derived from SOLANA_CLUSTER).
# SOLANA_RPC=https://api.devnet.solana.com
# Expected on-chain program id (informational/validation; the toju server supplies the
# actual deposit instruction). Local devnet deployment example:
# TOJU_PROGRAM_ID=AJQL4D6ydLYNLxcLNjXt8d4FGshAqsfLspowHkyiMnL7
TOJU_PROGRAM_ID=
# Path to the payer keypair JSON (Solana CLI format). MOUNTED at runtime, NEVER committed.
# e.g. ~/Desktop/c4gt-work/.keys/sol-payer.json
TOJU_PAYER_KEYPAIR=
# IPFS gateway used to retrieve stored files in real mode (the toju server pins to IPFS).
# Defaults to TOJU_API_URL when unset (correct for the mock, which serves /ipfs itself).
# TOJU_GATEWAY_URL=http://127.0.0.1:8080

# ── Misc ──────────────────────────────────────────────────────────────────────
# Legacy alias for SOLANA_CLUSTER (kept for back-compat; SOLANA_CLUSTER wins if both set).
SOLANA_NETWORK=devnet
# Default storage duration (days) if the caller does not specify one.
# TOJU_DEFAULT_DURATION_DAYS=1
# Safety rail: the sidecar REFUSES to start on mainnet unless this is exactly "true".
# Leave UNSET — never true.
# ALLOW_MAINNET=
