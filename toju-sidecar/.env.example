# toju-sidecar config — MOCK-BACKED by default.
TOJU_SIDECAR_PORT=5056
# Backend the SDK calls. In this integration, the local MOCK (toju-mock).
TOJU_API_URL=http://localhost:5057
# Shared secret required on every request (X-Toju-Token). MUST match Tornado's TOJU_SHARED_SECRET.
TOJU_SHARED_SECRET=change-me-dev-only
# TOJU_MODE is REQUIRED and must be set explicitly — there is NO default.
#   mock = offline, no real Solana/IPFS/money (drives the SDK against toju-mock)
#   real = talk to a real toju backend (set TOJU_API_URL + SOLANA_RPC + a signer too)
# The sidecar refuses to start if TOJU_MODE is unset or not one of mock|real.
TOJU_MODE=mock
# devnet only. The sidecar REFUSES to start on mainnet unless ALLOW_MAINNET=true (never set it).
SOLANA_NETWORK=devnet
# ALLOW_MAINNET=   # leave unset — never true
