# ── Kubo daemon RPC URL ───────────────────────────────────────────────────────
# Full URL to the running Kubo (go-ipfs) daemon's RPC API.
# Local daemon:        http://127.0.0.1:5001
# Docker Compose:      http://kubo:5001   (set via docker-compose environment block)
IPFS_API_URL=http://127.0.0.1:5001

# ── Sidecar HTTP port (default 5051 — S3 sidecar already uses 5050) ──────────
# MESHKIT_KUBO_SIDECAR_PORT=5051
