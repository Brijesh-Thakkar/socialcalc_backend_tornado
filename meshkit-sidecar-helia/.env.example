# ── Sidecar HTTP port (default 5052 — S3 uses 5050, Kubo uses 5051) ──────────
# MESHKIT_HELIA_SIDECAR_PORT=5052

# ── Filesystem paths for Helia's blockstore and datastore ────────────────────
# Must be on a persistent volume so blocks survive container restarts.
# HELIA_BLOCKSTORE_PATH=/data/helia/blocks
# HELIA_DATASTORE_PATH=/data/helia/datastore
# HELIA_CIDS_PATH=/data/helia/cids.json
