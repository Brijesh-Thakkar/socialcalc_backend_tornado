# Copy to docker/omamori/.env (gitignored) for `docker compose --profile omamori up`.
# Names only -- never commit values. See docs/omamori-integration.md.
#
# Required to boot: the firewall's Base Sepolia signing key. For local demos use a
# throwaway, UNFUNDED key; never fund or reuse it.
FIREWALL_PRIVATE_KEY=
# Optional stages; each missing key fails closed (ask_human -> World ID -> refuse).
INTERCEPTA_API_KEY=
TYPESAFE_API_KEY=
WORLD_CLIENT_ID=
WORLD_CLIENT_SECRET=
# Optional; defaults to the public Base Sepolia RPC.
BASE_SEPOLIA_RPC_URL=
