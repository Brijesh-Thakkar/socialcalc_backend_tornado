# ── MeshKit S3-compatible credentials (required) ─────────────────────────────
MESHKIT_ACCESS_KEY=
MESHKIT_SECRET_KEY=
MESHKIT_BUCKET=

# ── Storage endpoint (optional) ───────────────────────────────────────────────
# Leave unset to use the default fil.one endpoint (createFilOneClient).
# Set to an S3-compatible URL to use createS3Client instead.
#   Filebase:  https://s3.filebase.com
#   fil.one:   https://eu-west-1.s3.fil.one
#   MinIO:     http://localhost:9000
MESHKIT_ENDPOINT=

# ── Sidecar HTTP port (default 5050) ──────────────────────────────────────────
# MESHKIT_SIDECAR_PORT=5050
